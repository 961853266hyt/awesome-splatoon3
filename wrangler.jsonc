{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awesome-splatoon3",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    // Every real page is prerendered (see scripts/prerender.mjs), so unknown
    // paths get the nearest 404.html with a 404 status -- /zh/404.html under
    // /zh/ -- instead of the home page with a 200.
    "not_found_handling": "404-page",
    // Run the Worker before serving static assets so the workers.dev -> custom
    // domain redirect fires even for paths that match a built asset (e.g. "/").
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
